<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8">
    <title><%= post.title %></title>
    <style>
      body {
        font-family: 'DejaVu Sans', sans-serif;
        padding: 20px;
      }
      img {
        max-width: 100%;
        height: auto;
      }
    </style>
  </head>
  <body>
    <h1><%= post.title %></h1>
		<% if post.image.attached? %>
			<img src="<%= Rails.application.routes.url_helpers.rails_blob_url(post.image, host: 'http://localhost:3000') %>" alt="Post Image">
		<% else %>
			<p>No image available</p>
		<% end %>
    <p><%= post.description %></p>
    <p><strong>Posted by:</strong> <%= post.user.username %></p>
    <p><strong>Date:</strong> <%= post.created_at.strftime('%d %B %Y, %I:%M %p') %></p>
  </body>
</html>
