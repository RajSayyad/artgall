<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8">
    <title><%= post.title %></title>
    <style>
      body {
        font-family: 'DejaVu Sans', sans-serif;
        margin: 0;
        padding: 0;
      }
      .content {
        /* margin-top: 60px;
        margin-bottom: 60px;
        padding: 20px;
        position: relative;
        z-index: 1; */
        page-break-before: always;
      }

      .description {
        page-break-inside: avoid;
        white-space: pre-wrap;
      }

      .page-break {
        page-break-before: auto;
      }

      img {
        max-width: 100%;
        max-height: 80vh;
        height: auto;
        width: auto;
        display: block;
        margin: 0 auto;
      }

      @page {
        margin-top: 60px;
        margin-bottom: 60px;
        margin-left: 2cm;
        margin-right: 2cm;
      }

    </style>
  </head>
  <body>
    <div class="content">
      <h1><%= post.title %></h1>

      <% if post.image.attached? %>
        <img src="<%= Rails.application.routes.url_helpers.rails_blob_url(post.image, host: 'http://localhost:3000') %>" alt="Post Image">
      <% else %>
        <p>No image available</p>
      <% end %>

      <div class="description">
        <h1 style="text-align: center;">Description</h1>
        <%= raw(simple_format(post.description)) %>
      </div>
      <p><strong>Posted by:</strong> <%= post.user.username %></p>
      <p><strong>Date:</strong> <%= post.created_at.strftime('%d %B %Y, %I:%M %p') %></p>
    </div>
  </body>
</html>
